[Unit]
Description=px-manager
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ px_manager_user }}
Group={{ px_manager_group }}
WorkingDirectory={{ px_manager_home }}
EnvironmentFile={{ px_manager_cookie_env }}
ExecStart={{ px_manager_bin_dir }}/px-manager --data-dir {{ px_manager_data_dir }} --host 127.0.0.1 --port {{ px_manager_service_port }}{% for origin in px_manager_cors_origins %} --cors-origin {{ origin | quote }}{% endfor %}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ px_manager_data_dir }}

[Install]
WantedBy=multi-user.target
