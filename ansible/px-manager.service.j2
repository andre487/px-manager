[Unit]
Description=px-manager
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ px_manager_user }}
Group={{ px_manager_group }}
WorkingDirectory={{ px_manager_home }}
EnvironmentFile={{ px_manager_cookie_env }}
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart={{ px_manager_venv_dir }}/bin/python {{ px_manager_source_dir }}/main.py --data-dir {{ px_manager_data_dir }} --config-dir {{ px_manager_config_dir }} --log-dir {{ px_manager_log_dir }} --state-dir {{ px_manager_state_dir }} --host 127.0.0.1 --port {{ px_manager_service_port }}{% for origin in px_manager_cors_origins %} --cors-origin {{ origin | quote }}{% endfor %}

Restart=on-failure
RestartSec=5
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ px_manager_data_dir }}/message.md {{ px_manager_data_dir }}/tg-proxies.txt {{ px_manager_state_dir }} {{ px_manager_log_dir }}

[Install]
WantedBy=multi-user.target
